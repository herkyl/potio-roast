# Required
GOOGLE_GENERATIVE_AI_API_KEY=...
ALLSCREENSHOTS_API_KEY=...

# Optional — model override.
# Default: gemini-2.5-flash (free tier).
# Set to gemini-2.5-pro once you have billing enabled on Google AI.
# GEMINI_MODEL=gemini-2.5-pro

# Optional — screenshot mode for A/B testing pipeline speed vs quality.
#   full    (default) — full-page capture, attached to LLM. Slowest, richest.
#   trimmed           — capture first 4000px only, attached to LLM. Faster.
#   off               — no screenshot. UI shows "unavailable", LLM is text-only.
# SCREENSHOT_MODE=full

# Optional — rate limiting (recommended for production)
# Get free credentials at https://upstash.com (free tier: 10k commands/day)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — comma-separated IPs that bypass rate limiting in production.
# Useful for your own IP during demos so you don't burn the 80/day quota.
# In `npm run dev` the limiter is already off; this only matters in prod.
# Find your IP: curl ifconfig.me
# RATELIMIT_BYPASS_IPS=1.2.3.4
